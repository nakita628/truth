{
  "name": "truth-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bazel build //...",
    "check": "vp fmt --check && vp run --filter './packages/*' check && pnpm lint",
    "deps": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
    "fix": "vp fmt && vp run --filter './packages/*' check --fix && markdownlint-cli2 --fix && textlint --fix \"**/*.md\" \"**/*.mdc\"",
    "lint": "pnpm lint:md && pnpm lint:text && pnpm lint:spell && pnpm lint:secret && pnpm lint:actions && pnpm lint:links",
    "lint:actions": "node lint/actionlint.mjs",
    "lint:links": "textlint --config .textlintrc.links.json \"**/*.md\" \"**/*.mdc\"",
    "lint:md": "markdownlint-cli2",
    "lint:secret": "secretlint --secretlintignore .secretlintignore --maskSecrets \"**/*\"",
    "lint:spell": "cspell --no-progress --dot \"**/*.{md,mdc,ts,js,mjs,json,jsonc,yaml,yml,bazel,bzl}\"",
    "lint:text": "textlint \"**/*.md\" \"**/*.mdc\"",
    "test": "bazel test //..."
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@textlint-rule/textlint-rule-no-unmatched-pair": "2.0.4",
    "actionlint": "2.0.6",
    "cspell": "10.4.0",
    "markdownlint-cli2": "0.24.0",
    "secretlint": "13.1.0",
    "textlint": "15.8.0",
    "textlint-filter-rule-comments": "1.3.0",
    "textlint-rule-no-dead-link": "6.2.3",
    "textlint-rule-no-todo": "2.0.1",
    "textlint-rule-terminology": "5.2.16",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@12.15.0"
}
