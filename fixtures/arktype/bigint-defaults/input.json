{
  "title": "Limits",
  "type": "object",
  "$defs": {
    "Big": { "type": "integer", "format": "bigint" }
  },
  "properties": {
    "between": {
      "type": "integer",
      "format": "bigint",
      "minimum": 1,
      "exclusiveMinimum": 5,
      "maximum": 10,
      "exclusiveMaximum": 8
    },
    "large": { "type": "integer", "format": "int64", "default": 9007199254740992 },
    "level": { "type": "integer", "format": "int64", "enum": [9007199254740992, 2] },
    "big": { "$ref": "#/$defs/Big", "default": 5 },
    "maybe": { "anyOf": [{ "$ref": "#/$defs/Big" }, { "type": "null" }], "default": 6 }
  }
}
